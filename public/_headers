# Cloudflare Workers custom headers, applied at deploy time.
#
# Next.js copies everything in `public/` to the root of the static export, so
# this file ships as `out/_headers` and Workers picks it up automatically.
#
# Without it, hashed assets under /_next/static/ are served as
# `cache-control: public, max-age=0, must-revalidate` — so every returning
# visitor revalidates and re-downloads the whole ~1.2MB of JS, CSS and fonts.
# Those filenames contain a content hash, so they can never change meaning and
# are safe to cache indefinitely.
#
# HTML is deliberately left alone: it keeps the default `max-age=0,
# must-revalidate`, which is what you want for a document that changes.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400
