# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Timeline media. All of it is generated: the sources are committed nowhere
# (far too large), and the processed output is rebuilt from them. `npm run
# media` regenerates, and `npm run build` depends on it, so nothing is ever
# missing — but none of it belongs in history. See content/years.ts for the
# filename convention.
/content/media/
/public/photos/
/public/videos/

# Crowd audio. Fetched from the Internet Archive by `npm run media:audio:fetch`
# rather than committed — CC0, but 21MB of tape does not belong in history, and
# the fetch script is the record of where it came from.
/content/audio/
/public/audio/
