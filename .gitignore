# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Processed media. Never committed: this is all build output, regenerated from
# the committed sources in content/media/ by `npm run build`. See
# content/years.ts for the filename convention.
/public/photos/
/public/videos/

# The score's cut versions, same reasoning — rebuilt from the committed masters
# in content/audio/music/ by `npm run media:music`. The windows live in
# content/music.ts.
/public/audio/

# content/media/ and content/audio/music/ used to be ignored here, on the
# grounds that 101MB of photographs and commercial masters did not belong in
# history. It does now, deliberately: the site is not reproducible without it,
# and a clone that generates placeholders is a different site. That is ~101MB
# of history that cannot be cheaply unwritten, so if the sources ever change
# and the old ones should go, that is a history rewrite — not a normal commit.
