{
  "name": "ankhi-19",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run media && next build",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "media": "npm run media:placeholders && npm run media:images && npm run media:videos && npm run media:music",
    "media:placeholders": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-placeholders.mjs",
    "media:images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/optimize-images.mjs",
    "media:videos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/encode-videos.mjs",
    "media:music": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/encode-music.mjs",
    "deploy": "npm run build && wrangler deploy",
    "serve": "node scripts/serve.mjs out",
    "typecheck": "tsc --noEmit",
    "deploy:dry": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.141.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260925.1": true
  }
}
